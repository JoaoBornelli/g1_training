+    "# é mais pesada que a `velocity` pura do mjlab.\n",
+    "nome, vram = smi.stdout.split(\",\")[0].strip(), smi.stdout.split(\",\")[1].strip()\n",
+    "mb = int(\"\".join(c for c in vram if c.isdigit()))\n",
+    "NUM_ENVS = 2048 if mb < 20000 else (4096 if mb < 45000 else 8192)\n",
