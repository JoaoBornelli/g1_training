+print("\nok")
+"""
+import subprocess, sys
+r = subprocess.run([sys.executable, "-c", CHECK], capture_output=True, text=True)
+print(r.stdout)
+print(r.stderr[-2000:] if r.returncode else "")
+assert r.returncode == 0, "verificação falhou — leia o erro acima"'''),
