+    "assert \"entrega_do_navegador\" in e\n",
+    "assert list(e).index(\"reset_base\") < list(e).index(\"entrega_do_navegador\")\n",
+    "\n",
+    "# ⚠ CUSTOU 8,6 h #3 — o bloco 2 colapsou por GIRO. Quatro consertos, e os quatro\n",
